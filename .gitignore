# Binaries and build outputs
/bin/
/dist/
/artifacts/
/test/e2e/*/artifacts/
/cover.out
# `go build ./<path>` from the root writes the binary here, named after the
# package directory. Root-anchored so that the cmd/ directories stay tracked.
/console
/operator
/evidence-agent
/evidence-agent
/pgtoolbox
/readonlycheck
/evidence-fingerprint
/loadgen
/gen
/evidence-artifacts
*.coverprofile
coverage.txt

# Editor and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Local environment files
.env
.env.*
!.env.example

# Node
node_modules/

# Generated by `make docs-bundle` or the console image build (never committed:
# a committed index.bin conflicted between every two pull requests touching the
# docs). data/.keep is the placeholder go:embed needs on a fresh clone.
/internal/console/docsbundle/data/*
!/internal/console/docsbundle/data/.keep
