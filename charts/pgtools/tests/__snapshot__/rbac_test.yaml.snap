pins the watched-namespace Role (a change to the console's authority shows up as a snapshot diff):
  1: |
    - apiGroups:
        - postgresql.cnpg.io
      resources:
        - clusters
        - backups
        - scheduledbackups
        - poolers
        - databases
        - databaseroles
        - publications
        - subscriptions
        - failoverquorums
        - imagecatalogs
