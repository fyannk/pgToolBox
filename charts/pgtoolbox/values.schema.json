              "properties": {
                "allowedUsers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allowedGroups": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "workloadIdentity": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowedUsers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allowedGroups": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
