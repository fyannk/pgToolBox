        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 40,
          "maximum": 3600
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "apiServer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "addresses",
                    "any"
                  ]
                },
                "addresses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "podLabels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "ingress": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "metricsFrom": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "extraEgress": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "restoreDrillGuard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"enum": ["auto", true, false]}
          }
        },
        "admissionPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validationActions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "Deny",
                  "Warn",
                  "Audit"
                ]
              }
            },
            "imageOverride": {
              "type": "object",
