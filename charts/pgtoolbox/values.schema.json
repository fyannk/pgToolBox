{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pgtoolbox chart values",
  "description": "Strict: a misspelt key is an error, not a silently ignored setting, in the operator block and in the top-level operator pod settings.",
  "type": "object",
  "additionalProperties": false,
