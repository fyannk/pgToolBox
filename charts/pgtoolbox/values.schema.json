                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  }
                }
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "certSecret": {
                  "type": "string",
                  "maxLength": 253
                },
                "caSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 253
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "serverName": {
                  "type": "string"
                }
              }
            },
            "serviceMonitor": {
              "$ref": "#/definitions/monitor"
