    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "leaderElection": {
      "type": "boolean"
    },
    "metricsBindAddress": {
      "type": "string",
      "pattern": "^[^:]*:[0-9]+$"
    },
    "healthProbeBindAddress": {
      "type": "string",
      "pattern": "^[^:]*:[0-9]+$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "request": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "appArmorProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost",
                "Unconfined"
              ]
            },
            "localhostProfile": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        "fsGroup": {
          "type": "integer"
