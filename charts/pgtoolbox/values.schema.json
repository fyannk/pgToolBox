        "fsGroupChangePolicy": {
          "enum": [
            "OnRootMismatch",
            "Always"
          ]
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seLinuxChangePolicy": {
          "type": "string"
        },
        "seLinuxOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "user": {
              "type": "string"
            }
          }
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost",
                "Unconfined"
              ]
            },
            "localhostProfile": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        "supplementalGroups": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "supplementalGroupsPolicy": {
          "enum": [
            "Merge",
            "Strict"
          ]
        },
        "sysctls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        },
        "windowsOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gmsaCredentialSpec": {
              "type": "string"
            },
            "gmsaCredentialSpecName": {
              "type": "string"
            },
            "hostProcess": {
              "type": "boolean"
            },
            "runAsUserName": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
