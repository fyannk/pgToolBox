      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": [
                "integer",
                "string"
              ]
            },
            "host": {
              "type": "string"
            },
            "scheme": {
              "enum": [
                "HTTP",
                "HTTPS"
              ]
