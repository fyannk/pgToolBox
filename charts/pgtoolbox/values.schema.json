            "reconciliationTimeout": {
              "type": "string",
              "pattern": "^$|^([0-9]+(h|m|s))+$"
            },
            "upgradeBackupsKept": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readerClusterRole": {
              "type": "boolean"
