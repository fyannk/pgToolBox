            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "privileged": {
          "type": "boolean"
        },
        "procMount": {
          "type": "string"
        },
        "readOnlyRootFilesystem": {
          "const": true
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seLinuxOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "user": {
              "type": "string"
            }
          }
        },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost",
                "Unconfined"
              ]
            },
            "localhostProfile": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ]
        },
        "windowsOptions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gmsaCredentialSpec": {
              "type": "string"
            },
            "gmsaCredentialSpecName": {
              "type": "string"
            },
            "hostProcess": {
              "type": "boolean"
            },
            "runAsUserName": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "livenessProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "httpGet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": [
                "integer",
                "string"
