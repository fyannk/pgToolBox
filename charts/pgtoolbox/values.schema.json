    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "const": false
        },
        "appArmorProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "RuntimeDefault",
                "Localhost",
                "Unconfined"
              ]
