          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^$|^[^\\s]+$"
            },
            "imageRepository": {
              "type": "string",
              "minLength": 1
            },
            "imageRepositories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s,]+$"
              }
            }
          }
        },
        "console": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "imageRepositories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s,]+$"
              }
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^$|^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "pgAdmin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^$|^[^\\s]+$"
            },
            "imageRepositories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s,]+$"
              }
            }
          }
        },
        "oauthProxyImage": {
          "type": "string",
          "pattern": "^$|^[^\\s]+$"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "watchNamespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
