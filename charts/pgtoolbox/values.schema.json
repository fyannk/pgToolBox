    "podMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(h|m|s))+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "bearerTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 253
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "monitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(h|m|s))+$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
