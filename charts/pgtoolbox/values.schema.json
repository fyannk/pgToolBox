        "create": {
          "type": "boolean"
        },
        "podSecurity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enforce": {
              "enum": [
                "privileged",
                "baseline",
                "restricted"
              ]
            },
            "audit": {
              "enum": [
                "privileged",
                "baseline",
                "restricted"
              ]
            },
            "warn": {
              "enum": [
                "privileged",
                "baseline",
                "restricted"
              ]
            }
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
