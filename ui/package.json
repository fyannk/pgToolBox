{
  "name": "@pgtoolbox/console-ui",
  "version": "0.0.0",
  "private": true,
  "description": "pgToolBox console single-page application and design system. Renders Go view models; derives nothing.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "generate": "orval && tsr generate && node scripts/sync-fixtures.mjs",
    "generate:check": "sh scripts/check-generated.sh",
    "fixtures": "node scripts/sync-fixtures.mjs",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy localStorage preferredLanguage baseLocale",
    "lint": "biome check . && node scripts/check-semantic.mjs",
    "format": "biome check --write .",
    "typecheck": "tsc",
    "knip": "knip",
    "tokens": "cd tokens && node --test && node scripts/generate.mjs --check",
    "test": "sh scripts/netns.sh vitest run --project unit --maxWorkers=2",
    "test:stories": "sh scripts/netns.sh vitest run --project storybook --maxWorkers=2",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "build": "vite build && node scripts/precompress.mjs dist",
    "build:harness": "vite build --mode harness",
    "preview:harness": "vite preview --mode harness --port 4317 --strictPort",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots=all",
    "size": "size-limit",
    "check": "pnpm i18n && pnpm generate:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm tokens && pnpm test && pnpm test:stories && pnpm build-storybook && pnpm build && pnpm size",
    "check:light": "pnpm i18n && pnpm generate:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm tokens && pnpm test && pnpm build && pnpm size"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@pgtoolbox/ui-tokens": "workspace:*",
    "@tanstack/react-query": "5.105.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "@xyflow/react": "12.12.1",
    "diff": "9.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@faker-js/faker": "10.6.0",
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.5.7",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "knip": "6.44.1",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "orval": "8.46.0",
    "playwright": "1.64.1",
    "size-limit": "14.3.0",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vitest-browser-react": "2.3.0"
  }
}
