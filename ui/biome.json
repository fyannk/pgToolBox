{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!src/api/generated",
      "!pnpm-lock.yaml",
      "!src/routeTree.gen.ts",
      "!src/paraglide",
      "!mocks/fixtures/scenarios.gen.ts",
      "!mocks/fixtures/json",
      "!mocks/fixtures/assistant",
      "!mocks/public",
      "!tokens/tokens.ts",
      "!**/*.css"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "correctness": { "useExhaustiveDependencies": "error", "useHookAtTopLevel": "error" },
      "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["error"] } } },
      "security": { "noDangerouslySetInnerHtml": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
