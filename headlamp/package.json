{
  "name": "pgtoolbox-console",
  "version": "0.1.0",
  "description": "Headlamp plugin for pgToolBox: open a CloudNativePG Cluster in the pgToolBox console and show the phase the operator reports",
  "license": "Apache-2.0",
  "homepage": "https://fyannk.github.io/pgToolBox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fyannk/pgToolBox.git",
    "directory": "headlamp"
  },
  "bugs": "https://github.com/fyannk/pgToolBox/issues",
  "private": true,
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "test": "CI=true headlamp-plugin test",
    "check": "npm ci --no-audit --no-fund && npm run lint && npm run tsc && npm run test && npm run build"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "cloudnative-pg",
    "postgresql"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "5.6.2",
    "tinypool": "2.1.2",
    "webpack-dev-middleware": "7.4.6",
    "vitest": "4.1.12",
    "@vitest/mocker": "4.1.12",
    "minimatch@>=7 <11.0.1": "11.0.4"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0"
  }
}
