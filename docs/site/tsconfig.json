{
  // This file is not used in compilation; `npm run typecheck` reads it.
  // @docusaurus/tsconfig's options, inlined: it still sets baseUrl, which
  // TypeScript 7 removed (paths resolve against this file without it).
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "exclude": [".docusaurus", "build"]
}
