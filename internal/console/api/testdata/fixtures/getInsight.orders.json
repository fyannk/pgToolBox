    {
      "id": "insight.primaryOnly",
      "panel": "insight",
      "text": "Wraparound, tables, indexes and statements are read on the primary only: an index read as unused counts primary scans, and the replicas' pg_stat_statements are not shown."
    },
    {
      "id": "insight.noStatementText",
      "panel": "insight",
      "text": "Statement text never leaves the database: the console shows the queryid, and pgAdmin shows the text."
    },
    {
      "id": "insight.inMemoryHistory",
      "panel": "insight",
      "text": "Consumption rates, autovacuum verdicts and regressions rest on samples the console keeps in memory: they start again when the console restarts."
    },
    {
      "id": "insight.topStatementsOnly",
      "panel": "insight",
      "text": "The console keeps each hour's costliest statements only: a statement that entered them lately has no baseline a day earlier and is not compared."
    },
    {
      "id": "insight.exporterCache",
      "panel": "insight",
      "text": "The exporter caches its custom queries for the Cluster's metricsQueriesTTL (30 s by default): a refreshed lock graph can be that old."
    },
    {
      "id": "insight.multixactMembers",
      "panel": "insight",
      "text": "Multixact member space is not read: it can run out before multixact ids do, and autovacuum then freezes multixacts earlier than autovacuum_multixact_freeze_max_age says."
    },
    {
      "id": "insight.dynamicFreezeAge",
      "panel": "insight",
      "text": "The forecasts use the configured freeze ages: PostgreSQL lowers the effective multixact freeze age on its own when member space runs short, which they do not show."
    },
    {
